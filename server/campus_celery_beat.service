[Unit]
Description=Celery Beat Scheduler for Campus Detection
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/Campus-detection/back_end
RuntimeDirectory=celery-beat
RuntimeDirectoryMode=0755
LogsDirectory=celery-beat
LogsDirectoryMode=0755
Environment=DJANGO_SETTINGS_MODULE=campus_detection.settings
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/Campus-detection/back_end/venv/bin/celery -A campus_detection beat --loglevel=INFO --pidfile=/run/celery-beat/beat.pid --schedule=/run/celery-beat/celerybeat-schedule --logfile=/var/log/celery-beat/beat.log
Restart=always
RestartSec=5
CPUQuota=20%
MemoryMax=180M
TasksMax=16
Nice=10

[Install]
WantedBy=multi-user.target
