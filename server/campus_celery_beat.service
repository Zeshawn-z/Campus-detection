[Unit]
Description=Celery Beat Scheduler for Campus Detection
After=network.target

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /run/celery
ExecStartPre=/bin/mkdir -p /var/log/celery
ExecStartPre=/bin/chown -R www-data:www-data /run/celery
ExecStartPre=/bin/chown -R www-data:www-data /var/log/celery
User=www-data
Group=www-data
WorkingDirectory=/var/www/Campus-detection/back_end
Environment=DJANGO_SETTINGS_MODULE=campus_detection.settings
ExecStart=/var/www/Campus-detection/back_end/venv/bin/celery -A campus_detection beat --loglevel=INFO --pidfile=/run/celery/beat.pid --schedule=/run/celery/celerybeat-schedule --logfile=/var/log/celery/beat.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
